{
  "name": "setup-installforge",
  "version": "1.0.0",
  "description": "GitHub Action to setup InstallForge",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.js -o dist --source-map --license licenses.txt",
    "package": "ncc build src/index.js -o dist --source-map --license licenses.txt",
    "test": "jest",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dylan-gonzalez/setup-installforge.git"
  },
  "keywords": [
