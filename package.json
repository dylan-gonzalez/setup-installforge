    "windows",
    "installer",
    "setup"
  ],
  "author": "dylan-gonzalez",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/tool-cache": "^2.0.1",
    "@actions/http-client": "^2.2.1"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  }
}